{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "semi": "off",
    "import/prefer-default-export": "off",
    "import/extensions": 0,
    "no-unused-vars": "warn"
  }
}
