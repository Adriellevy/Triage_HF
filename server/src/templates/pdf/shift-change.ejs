<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte de Cambios de Turnos</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        .container {
            width: 100%;
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table th, table td {
            border: 1px solid #ddd;
            padding: 8px;
        }
        table th {
            background-color: #f4f4f4;
        }
        table td {
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>REPORTE DE CAMBIOS DE TURNOS</h1>
        <div class="table">
            <table>
                <thead>
                    <tr>
                        <th>Paciente</th>
                        <th>Doctor saliente</th>
                        <th>Doctor entrante</th>
                        <th>Enfermero saliente</th>
                        <th>Enfermero entrante</th>
                        <th>Observaciones</th>
                        <th>Procedimientos</th>
                        <th>Antecedentes</th>
                        <th>Historial de cambios</th>
                    </tr>
                </thead>
                <tbody>
                    <% patients.forEach(patient => { %>
                        <tr>
                            <td><%= patient.patient_name %></td>
                            <td><%= patient.doctor_outgoing %></td>
                            <td><%= patient.doctor_incoming %></td>
                            <td><%= patient.nurse_outgoing %></td>
                            <td><%= patient.nurse_incoming %></td>
                            <td><%= patient.observations %></td>
                            <td><%= patient.procedures %></td>
                            <td><%= patient.records %></td>
                            <td>
                                <a href="http://localhost:5173/patients/<%= patient.patient_id %>">
                                    Ver historial
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
