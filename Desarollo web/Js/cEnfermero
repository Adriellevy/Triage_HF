import { cPaciente } from './cPaciente.js';

class cEnfermero {
    /**
     * Esta clase tiene como objetivo dar a conocer el/la enfermer@ de triage que se encargó de
     * clasificar al paciente que fue registrado y luego de esto se encuentra en la sala de espera para ser atendido
     * @param {string} Nombre - Nombre del enfermero (por defecto, "def").
     * @param {string} Matricula - Matrícula del enfermero (por defecto, "111111").
     */
    private _nombre: string;
    private _Matricula: string;

    constructor(Nombre: string = "def", Matricula: string = "111111") {
        this._nombre = Nombre;
        this._Matricula = Matricula;
    }

    /**
     * Obtiene el nombre del enfermero.
     * @returns {string} - Nombre del enfermero.
     */
    getNombreEnfermero(): string {
        return this._nombre;
    }

    /**
     * Obtiene la matrícula del enfermero.
     * @returns {string} - Matrícula del enfermero.
     */
    getMatricula(): string {
        return this._Matricula;
    }

    /**
     * Clasifica al paciente con la información proporcionada.
     * @param {string} _nombre - Nombre del paciente.
     * @param {string} _color - Color asignado al paciente.
     * @param {string} _casoClinico - Caso clínico del paciente.
     * @param {number} edad - Edad del paciente.
     * @param {string} textohisotrial - Texto histórico del paciente.
     * @returns {cPaciente} - Nuevo objeto de la clase cPaciente.
     */
    Clasificar(_nombre: string, _color: string, _casoClinico: string, edad: number, textohisotrial: string): cPaciente {
        /**
         * Toda esta información viene de la interfaz del usuario, y el usuario que agendó.
         * Se agrega al paciente a la base de datos.
         */
        const NuevoPaciente = new cPaciente(_nombre, _color, edad, _casoClinico, this, textohisotrial);
        return NuevoPaciente;
    }
}

module.exports = {cEnfermero };
